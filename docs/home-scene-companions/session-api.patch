diff --git a/tests/test_home_scene.py b/tests/test_home_scene.py
new file mode 100644
index 0000000..990cc7e
--- /dev/null
+++ b/tests/test_home_scene.py
@@ -0,0 +1,74 @@
+from copy import deepcopy
+import pytest
+from blupe_evals.session_api import SessionApiService,MockJetson,MockRunner
+
+
+def setup():
+    service=SessionApiService(clock=lambda:1000.,lease_ttl_s=30)
+    jetson=MockJetson(service);one=MockRunner(service);two=MockRunner(service)
+    one.join();two.join()
+    service.home_scene_report(one.session_id,{'profile':'a'*64})
+    service.home_scene_report(two.session_id,{'profile':'a'*64})
+    scene=dict(version=1,scene_id='scene',robot_id='yam-1',config_sha256='b'*64,
+        boot_id='boot',captured_at=999.,frames={k:{'jpeg_base64':'AA=='} for k in ('left','top','right')})
+    return service,jetson,one,two,scene
+
+
+def offer(service,runner,scene):
+    service.jetson_home_scene('yam-1',dict(phase='offer',session_id=runner.session_id,scene=scene))
+
+
+def test_only_idle_queue_head_may_receive_offer_and_no_lease_is_granted():
+    s,j,a,b,scene=setup()
+    with pytest.raises(ValueError):offer(s,b,scene)
+    offer(s,a,scene)
+    assert s.get_home_scene(a.session_id)['scene']['scene_id']=='scene'
+    assert 'scene' not in s.get_home_scene(b.session_id)
+    assert s.get_session(a.session_id)['status']=='queued'
+    j.ready()
+    with pytest.raises(ValueError):offer(s,b,scene)
+
+
+def test_ready_requires_actual_lease_and_same_provenance():
+    s,j,a,b,scene=setup();offer(s,a,scene);assignment=j.ready()
+    ready=dict(phase='ready',session_id=a.session_id,episode_id=assignment['episode_id'],
+        lease_id=assignment['lease_id'],scene_id='scene',config_sha256='b'*64,boot_id='boot')
+    with pytest.raises(ValueError):s.jetson_home_scene('yam-1',{**ready,'lease_id':'wrong'})
+    s.jetson_home_scene('yam-1',{**ready,'config_sha256':'c'*64})
+    assert not s.get_home_scene(a.session_id)['ready']
+
+
+def test_measured_samples_scoped_deduplicated_and_queue_reassignment_cannot_reuse():
+    s,j,a,b,scene=setup();offer(s,a,scene)
+    report={'profile':'a'*64,'config_sha256':'b'*64,'first_executable_plan_s':12.}
+    s.home_scene_report(a.session_id,report)
+    s.home_scene_report(a.session_id,{**report,'first_executable_plan_s':500.})
+    assert s.home_scene_hint(a.session_id,'b'*64)['mean_first_plan_s']==12
+    assert s.home_scene_hint(a.session_id,'b'*64)['sample_count']==1
+    assert s.home_scene_hint(a.session_id,'c'*64)['mean_first_plan_s'] is None
+    s.stop_session(a.session_id)
+    assert s.get_home_scene(a.session_id)['scene'] is None
+    offer(s,b,scene)
+    assert s.get_home_scene(b.session_id)['ready'] is False
+    assert s.home_scene_hint(b.session_id,'b'*64)['sample_count']==1
+
+
+@pytest.mark.parametrize('changes',[{'captured_at':0},{'robot_id':'other'},{'config_sha256':'bad'},{'frames':{}}])
+def test_invalid_scene_rejected(changes):
+    s,j,a,b,scene=setup()
+    with pytest.raises(ValueError):offer(s,a,{**scene,**changes})
+
+
+def test_unknown_or_nonfinite_measurements_do_not_become_averages():
+    s,j,a,b,scene=setup();offer(s,a,scene)
+    assert s.home_scene_hint(a.session_id,'b'*64)['mean_first_plan_s'] is None
+    for value in [float('nan'),float('inf'),True,0,-1,601]:
+        with pytest.raises(ValueError):s.home_scene_report(a.session_id,dict(profile='a'*64,config_sha256='b'*64,first_executable_plan_s=value))
+
+
+def test_registration_extension_is_opt_in():
+    s=SessionApiService()
+    old=s.register_jetson('old').get_nowait()
+    new=s.register_jetson('new',home_scene=True).get_nowait()
+    assert 'home_scene_version' not in old
+    assert new['home_scene_version']==1
