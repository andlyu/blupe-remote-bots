@@ -0,0 +1,119 @@
+"""Authenticated queue-head planning offers; grants no motion authority."""
+import copy
+import math
+import re
+
+
+def digest(value):
+    return isinstance(value, str) and re.fullmatch('[a-f0-9]{64}', value) is not None
+
+
+class HomeSceneRequests:
+    def _home_init(self):
+        if not hasattr(self, '_home_offers'):
+            self._home_offers = {}
+            self._home_profiles = {}
+            self._home_samples = {}
+            self._home_sampled = set()
+
+    def home_scene_report(self, session_id, payload):
+        with self._lock:
+            self._home_init()
+            session = self._session(session_id)
+            if session.state not in {'queued','preparing','running'}:
+                raise ValueError('home scene run is no longer active')
+            if set(payload) - {'profile','first_executable_plan_s','config_sha256'} or not digest(payload.get('profile')):
+                raise ValueError('invalid home planning profile')
+            prior = self._home_profiles.get(session_id)
+            if prior is not None and prior != payload['profile']:
+                raise ValueError('home planning profile cannot change during a run')
+            self._home_profiles[session_id] = payload['profile']
+            if 'first_executable_plan_s' in payload:
+                elapsed = payload['first_executable_plan_s']
+                offer = self._home_offers.get(session_id, {})
+                if (type(elapsed) not in (int,float) or not math.isfinite(elapsed) or not 0 < elapsed <= 600
+                        or not digest(payload.get('config_sha256'))
+                        or payload['config_sha256'] != offer.get('config_sha256')):
+                    raise ValueError('invalid first executable plan sample')
+                if session_id not in self._home_sampled:
+                    key = (session.robot_id, payload['config_sha256'], payload['profile'])
+                    samples = self._home_samples.setdefault(key, [])
+                    samples.append(float(elapsed))
+                    del samples[:-20]
+                    self._home_sampled.add(session_id)
+            return {'version':1, 'accepted':True}
+
+    def home_scene_hint(self, session_id, config_sha256=None):
+        self._home_init()
+        session = self._session(session_id)
+        profile = self._home_profiles.get(session_id)
+        samples = self._home_samples.get((session.robot_id, config_sha256, profile), [])
+        return {'profile':profile, 'config_sha256':config_sha256, 'sample_count':len(samples),
+                'mean_first_plan_s':sum(samples)/len(samples) if samples else None}
+
+    def get_home_scene(self, session_id):
+        with self._lock:
+            self._home_init()
+            session = self._session(session_id)
+            if session.state not in {'queued','preparing','running'}:
+                return {'version':1, 'scene':None, 'ready':False}
+            offer = copy.deepcopy(self._home_offers.get(session_id, {}))
+            scene = offer.get('scene')
+            if scene and not 0 <= self._clock()-scene['captured_at'] <= 120:
+                offer.pop('scene', None)
+                offer['ready'] = False
+            if session.lease:
+                offer.update(lease_id=session.lease.lease_id,
+                             episode_id=session.episode.episode_id)
+            return {'version':1, **offer}
+
+    def jetson_home_scene(self, jetson_id, payload):
+        with self._lock:
+            self._home_init()
+            jetson = self._jetson(jetson_id)
+            session_id = payload.get('session_id')
+            session = self._session(session_id)
+            if session.robot_id != jetson_id:
+                raise ValueError('home scene robot mismatch')
+            phase = payload.get('phase')
+            if phase == 'offer':
+                queue = self._robot_queue(jetson_id)
+                if (jetson.active_session_id is not None or not queue or queue[0] != session_id
+                        or session.state != 'queued' or session_id not in self._home_profiles):
+                    raise ValueError('home scene offer requires the idle robot queue head')
+                scene = payload.get('scene')
+                if (not isinstance(scene, dict) or scene.get('version') != 1
+                        or scene.get('robot_id') != jetson_id or not digest(scene.get('config_sha256'))
+                        or not isinstance(scene.get('boot_id'), str) or not scene['boot_id']
+                        or not isinstance(scene.get('scene_id'), str) or not scene['scene_id']
+                        or type(scene.get('captured_at')) not in (int,float)
+                        or not 0 <= self._clock()-scene['captured_at'] <= 120):
+                    raise ValueError('invalid home scene provenance')
+                frames = scene.get('frames')
+                if not isinstance(frames, dict) or set(frames) != {'left','top','right'}:
+                    raise ValueError('home scene requires three views')
+                if any(not isinstance(f,dict) or not isinstance(f.get('jpeg_base64'), str)
+                       or len(f['jpeg_base64']) > 4*1024*1024 for f in frames.values()):
+                    raise ValueError('home scene frames too large')
+                self._home_offers[session_id] = dict(scene=copy.deepcopy(scene), ready=False,
+                    scene_id=scene['scene_id'], config_sha256=scene['config_sha256'], boot_id=scene['boot_id'])
+            elif phase == 'ready':
+                self._active(session_id, payload.get('episode_id'), payload.get('lease_id'), jetson_id=jetson_id)
+                if not digest(payload.get('config_sha256')) or not isinstance(payload.get('boot_id'), str):
+                    raise ValueError('invalid ready provenance')
+                prior = self._home_offers.get(session_id, {})
+                matched = all(prior.get(k) == payload.get(k) for k in ('scene_id','config_sha256','boot_id'))
+                self._home_offers[session_id] = {**prior, 'ready':bool(prior.get('scene') and matched),
+                    'config_sha256':payload['config_sha256'], 'boot_id':payload['boot_id'],
+                    'scene_id':payload.get('scene_id')}
+            elif phase == 'invalidate':
+                self._home_offers.pop(session_id, None)
+            else:
+                raise ValueError('unsupported home scene phase')
+            return {'accepted':True}
+
+    def _home_release(self, session_id):
+        self._home_init()
+        self._home_offers.pop(session_id, None)
+        self._home_profiles.pop(session_id, None)
+        self._home_sampled.discard(session_id)
