# Google release source revisions, including exact transitive Git sources.
FROM docker.io/library/python:3.12.9-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends git libgl1 libegl1 libosmesa6 ffmpeg && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir uv==0.11.24
WORKDIR /opt/playground
RUN git init && git remote add origin https://github.com/google-deepmind/mujoco_playground.git && git fetch --depth=1 origin c9de052f099a36be915af38344f427aacdbf3abe && git checkout --detach FETCH_HEAD
RUN uv sync --frozen --group cpu --no-default-groups --python /usr/local/bin/python
WORKDIR /opt/robotics
RUN git init && git remote add origin https://github.com/google-deepmind/robotics-antigravity-plugin.git && git fetch --depth=1 origin 9cb7f624c4d7c50859a39f1d49d088990429a83d && git checkout --detach FETCH_HEAD
# Preload both the robot and the table at the exact asset revision through the
# upstream local-repository mapping. Runtime cannot fetch additional assets.
WORKDIR /opt/mujoco_menagerie
RUN git init && git remote add origin https://github.com/google-deepmind/mujoco_menagerie.git && git sparse-checkout set i2rt_yam aloha && git fetch --filter=blob:none --depth=1 origin 370c43965323c0944b433b202aac5058b5f907a9 && git checkout --detach FETCH_HEAD
ENV PATH=/opt/playground/.venv/bin:$PATH MUJOCO_GL=osmesa OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 PYTHONUNBUFFERED=1
COPY simulation_entry.py /opt/gemini/simulation_entry.py
WORKDIR /workspace
ENTRYPOINT ["python", "/opt/gemini/simulation_entry.py"]
